# Application Configuration
# Origin only (scheme://host[:port], no path): index.html also uses it as the CSP connect-src.
VITE_API_BASE_URL=http://localhost:8000

# Optional. Sentry DSN for browser error tracking; leave empty to disable.
# Its ingest origin is added to the CSP connect-src at build time.
VITE_SENTRY_DSN=
