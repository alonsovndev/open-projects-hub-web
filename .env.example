# Application Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google Stitch MCP Server Configuration
# Required for MCP integration to work with Google Stitch designs
# Get these credentials from your Google Stitch project settings

# Your Google Stitch API key
GOOGLE_STITCH_API_KEY=your_api_key_here

# Your Google Stitch project ID
GOOGLE_STITCH_PROJECT_ID=your_project_id_here

# Optional: Custom Stitch API URL (if using a different endpoint)
# GOOGLE_STITCH_API_URL=https://api.stitch.google.com/v1
